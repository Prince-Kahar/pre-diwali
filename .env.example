# =========================================================================
# College Pre-Diwali Celebration Web Application — Environment Variables
# =========================================================================

# --- SUPABASE CONFIGURATION ---
# Found in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server / Edge Function secrets (NEVER expose to frontend code)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_PASSWORD=your_secure_db_password

# --- PAYMENT GATEWAY CONFIGURATION (RAZORPAY) ---
# Key ID can be shared with frontend checkout; Key Secret and Webhook Secret must remain on server
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyId
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- EVENT & SYSTEM DEFAULTS ---
VITE_APP_NAME="College Pre-Diwali Celebration 2026"
VITE_DEFAULT_CURRENCY=INR
VITE_TIMEZONE=Asia/Kolkata
